{
  "name": "cxszn-menv",
  "private": true,
  "version": "0.0.1",
  "description": "Windows-first multi-runtime development environment manager",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "test": "pnpm -r --if-present test",
    "test:core": "pnpm --filter @cxszn-menv/core test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "validate:contracts": "pnpm --filter @cxszn-menv/mcp validate-contracts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
