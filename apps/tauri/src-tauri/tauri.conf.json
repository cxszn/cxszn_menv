{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cxszn_menv",
  "version": "../package.json",
  "identifier": "com.cxszn.menv",
  "build": {
    "beforeDevCommand": "pnpm --dir ../desktop dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir ../desktop build",
    "frontendDist": "../../desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MEnv",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:1420 ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "publisher": "cxszn",
    "resources": {
      "../../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../../../docs/windows-preview.zh-CN.md": "README.zh-CN.md"
    },
    "shortDescription": "Windows-first multi-runtime development environment manager",
    "longDescription": "MEnv manages PHP development runtimes and user-scoped environment activation on Windows.",
    "windows": {
      "allowDowngrades": false,
      "bundleVCRuntime": false,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "startMenuFolder": "cxszn_menv",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": false
  }
}
