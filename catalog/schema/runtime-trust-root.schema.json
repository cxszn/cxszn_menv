{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cxszn-menv:schema:runtime-trust-root:1",
  "title": "MEnv runtime catalog trust root",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "purpose", "keys"],
  "properties": {
    "schema_version": { "const": "1" },
    "purpose": { "const": "runtime-catalog" },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "algorithm", "public_key", "not_before", "not_after"],
        "properties": {
          "key_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$" },
          "algorithm": { "const": "ed25519" },
          "public_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
          "revoked": { "type": "boolean" },
          "not_before": { "type": "string", "format": "date-time" },
          "not_after": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
